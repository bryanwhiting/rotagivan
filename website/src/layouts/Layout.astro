---
import "../styles/global.css";
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const current = Astro.url.pathname;
const active = (path: string) => (current === path ? "page" : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a1c" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {Astro.site && <link rel="canonical" href={new URL(current, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <header class="header">
      <div class="wrap">
        <a href="/" class="brand" aria-label="Rota home">
          <img src="/favicon.svg" width="22" height="22" alt="" />
          Rota
        </a>
        <nav aria-label="Main navigation">
          <a href="/download/" aria-current={active("/download/")}>Download</a>
          <a href="/pricing/" aria-current={active("/pricing/")}>Pricing</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <p class="muted"><strong>Rota.</strong> A radial HUD for your Mac.</p>
        <nav aria-label="Footer navigation">
          <a href="/download/">Download</a>
          <a href="/pricing/">Pricing</a>
          <a href="/latest.json">latest.json</a>
        </nav>
        <p class="fineprint">Not affiliated with Apple or ZSA.</p>
      </div>
    </footer>
  </body>
</html>
