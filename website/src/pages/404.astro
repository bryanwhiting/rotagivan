---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found — Rota"
  description="Find your way back to Rota."
>
  <section class="page-hero wrap">
    <span class="overline">404</span>
    <h1>Page not found</h1>
    <p class="lede">This page isn't here.</p>
    <div class="button-row" style="margin-top:22px">
      <a class="button" href="/">Go to Rota</a>
      <a class="button secondary" href="/download/">Download</a>
    </div>
  </section>
</Layout>
