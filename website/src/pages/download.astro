---
import Layout from "../layouts/Layout.astro";
import DownloadButton from "../components/DownloadButton.astro";
---

<Layout
  title="Download Rota for Mac"
  description="Download the latest Rota for macOS. Open the disk image, drag Rota to Applications, and grant Accessibility."
>
  <div class="wrap">
    <section class="page-hero">
      <h1>Download Rota</h1>
      <p class="lede">
        One disk image. Drag it to Applications and Rota lives in your
        menu bar.
      </p>
    </section>

    <div class="card download-panel">
      <DownloadButton withVersion variant="large" label="Download Rota" />
      <p class="fineprint" data-published hidden></p>
    </div>

    <section class="section" aria-labelledby="install-heading">
      <h2 id="install-heading">Install in three steps</h2>
      <ol class="steps" aria-label="Install steps">
        <li>
          <span>
            Open the disk image and drag <b>Rota</b> onto the <b>Applications</b> folder.
          </span>
        </li>
        <li data-gatekeeper-step>
          <span>
            First launch: in Applications, right-click <b>Rota</b>,
            choose <b>Open</b>, then click <b>Open</b> again.
            <small>
              This build is signed for development and not yet notarized by
              Apple, so macOS asks once. If you double-clicked instead, go to
              System Settings › Privacy &amp; Security and click <b>Open Anyway</b>.
            </small>
          </span>
        </li>
        <li>
          <span>
            Grant <b>Accessibility</b> in System Settings › Privacy &amp;
            Security › Accessibility, and <b>Input Monitoring</b> if asked.
            <small>
              Rota needs these to read trackpad gestures, send your
              keystrokes and move windows. Voice mode asks for the microphone
              only when you first use it. Upgrading from Rotagivan? macOS sees
              Rota as a new app, so grant both once more; your settings,
              shortcuts and sync login carry over.
            </small>
          </span>
        </li>
      </ol>
      <p class="note">
        Already installed? The app checks for updates daily. To update now,
        open Settings › Sync &amp; backup › Download latest.
      </p>
    </section>

    <section class="section verify" aria-labelledby="verify-heading">
      <h2 id="verify-heading">Verify the download</h2>
      <details>
        <summary>Check the SHA-256 checksum</summary>
        <dl>
          <dt>File</dt>
          <dd><code data-file-name>Rota.dmg</code></dd>
          <dt>SHA-256</dt>
          <dd>
            <code data-sha256>
              <a href="/latest.json">see latest.json</a>
            </code>
          </dd>
        </dl>
        <p>Run this in Terminal and compare the output with the checksum above.</p>
        <pre><code>shasum -a 256 ~/Downloads/<span data-file-name>Rota.dmg</span></code></pre>
      </details>
    </section>

    <section class="section" aria-labelledby="faq-heading">
      <h2 id="faq-heading">Questions</h2>
      <details>
        <summary>Which Macs does it support?</summary>
        <p>
          macOS 13 or later on Apple silicon. The download above lists the
          minimum macOS and architecture for the current build.
        </p>
      </details>
      <details>
        <summary>Why does it need Accessibility?</summary>
        <p>
          Rota sends the keystrokes you configure, reads trackpad input
          and moves windows. macOS requires Accessibility for that, and you
          can revoke it any time in System Settings.
        </p>
      </details>
      <details>
        <summary>What stays on my Mac?</summary>
        <p>
          Gestures, hotkeys, macros and HUDs run locally. Voice mode sends
          audio to the provider you configure with your own API key. Sync
          uploads your settings only if you sign in. The daily update check
          downloads <a href="/latest.json">latest.json</a> from this site.
        </p>
      </details>
      <details>
        <summary>Is there a zip instead of a disk image?</summary>
        <p>
          Yes. Each release also ships as a zip for scripted installs:
          <a href="/latest.json" data-zip-link>see latest.json</a>.
        </p>
      </details>
    </section>
  </div>
</Layout>

<script>
  import { getLatest, absoluteUrl, fileName } from "../scripts/latest";

  getLatest().then((m) => {
    if (!m) return;
    if (m.notarized) document.querySelector("[data-gatekeeper-step]")?.remove();

    const name = fileName(m.url);
    document.querySelectorAll<HTMLElement>("[data-file-name]").forEach((n) => (n.textContent = name));
    const sha = document.querySelector<HTMLElement>("[data-sha256]");
    if (sha) sha.textContent = m.sha256;

    const zip = document.querySelector<HTMLAnchorElement>("[data-zip-link]");
    if (zip && m.zip?.url) {
      zip.href = absoluteUrl(m.zip.url).href;
      zip.textContent = fileName(m.zip.url);
    }

    const published = document.querySelector<HTMLElement>("[data-published]");
    if (published && m.publishedAt) {
      const date = new Date(m.publishedAt);
      if (!Number.isNaN(date.getTime())) {
        published.textContent = `Released ${date.toLocaleDateString(undefined, { dateStyle: "medium" })}.`;
        published.hidden = false;
      }
    }
  });
</script>
