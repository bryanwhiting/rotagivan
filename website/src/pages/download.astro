---
import Layout from "../layouts/Layout.astro";
import DownloadButton from "../components/DownloadButton.astro";
---

<Layout
  title="Download Rotagivan for Mac"
  description="Download the latest Rotagivan for macOS. Open the disk image, drag Rotagivan to Applications, and grant Accessibility."
>
  <div class="wrap">
    <section class="page-hero">
      <p class="eyebrow">DOWNLOAD</p>
      <h1>
        Rotagivan
        <br />
        <em>for Mac.</em>
      </h1>
      <p class="lede">
        One disk image. Drag it to Applications, open it, and Rotagivan settles
        into your menu bar.
      </p>
      <div class="button-row" style="justify-content:center;margin-top:36px">
        <DownloadButton />
      </div>
    </section>

    <ol class="install-steps" aria-label="Install steps">
      <li>
        <span>
          Open <b>Rotagivan.dmg</b> from your Downloads and drag
          <b>Rotagivan</b> onto the <b>Applications</b> folder.
        </span>
      </li>
      <li data-gatekeeper-step>
        <span>
          Open Rotagivan from Applications.
          <small data-gatekeeper-note>
            The first time, macOS may say it can't verify the developer —
            this early build isn't notarized by Apple yet. Click <b>Done</b>,
            open <b>System Settings → Privacy &amp; Security</b>, and click
            <b>Open Anyway</b> next to Rotagivan. You only do this once.
          </small>
        </span>
      </li>
      <li>
        <span>
          Allow <b>Accessibility</b> when asked so Rotagivan can run your
          actions and arrange windows.
          <small>
            Depending on your setup, macOS may also ask for Input Monitoring.
            Voice mode asks for the microphone only when you first use it.
          </small>
        </span>
      </li>
      <li>
        <span>
          Add your favorite app to the HUD, give it a hotkey or gesture, and try
          it.
          <small>
            Rotagivan checks for new versions and offers the download when one
            is ready. To update, drag the new version over the old one.
          </small>
        </span>
      </li>
    </ol>

    <p class="release-facts" data-release-facts hidden></p>

    <section class="faq">
      <h2>A little clarity.</h2>
      <details open>
        <summary>Which Macs does it support?</summary>
        <p>
          macOS 13 or later. The download page lists the processor types each
          build includes. Apple trackpad support is experimental; ZSA Navigator
          testing has focused on Voyager.
        </p>
      </details>
      <details>
        <summary>Why does it need Accessibility?</summary>
        <p>
          Rotagivan uses macOS permissions to send the inputs you configure and
          to move windows. You stay in control of those grants in System
          Settings → Privacy &amp; Security.
        </p>
      </details>
      <details>
        <summary>What stays local, and what goes online?</summary>
        <p>
          Keyboard, gesture and HUD actions run on your Mac. Voice mode sends
          audio and command text to the provider you configure. Account sync
          uploads your settings when you sign in; API keys are end-to-end
          encrypted. The update check downloads a small version file from this
          site.
        </p>
      </details>
      <details>
        <summary>How do I verify the download?</summary>
        <p>
          Every release lists its SHA-256 checksum above and in
          <a class="quiet-link" href="/latest.json">latest.json</a>. Run
          <code>shasum -a 256 ~/Downloads/Rotagivan-*.dmg</code> and compare.
        </p>
      </details>
    </section>
  </div>
</Layout>

<script>
  fetch("/latest.json", { cache: "no-cache" })
    .then((r) => (r.ok ? r.json() : null))
    .then((m) => {
      if (!m) return;
      if (m.notarized) document.querySelector("[data-gatekeeper-note]")?.remove();
      const facts = document.querySelector<HTMLElement>("[data-release-facts]");
      if (!facts) return;
      const date = m.publishedAt ? new Date(m.publishedAt).toLocaleDateString() : "";
      facts.innerHTML = "";
      const add = (label: string, value: string) => {
        const line = document.createElement("div");
        const code = document.createElement("code");
        code.textContent = value;
        line.append(`${label}: `, code);
        facts.append(line);
      };
      add("Latest", `${m.version} (build ${m.build})${date ? ` · ${date}` : ""}`);
      add("SHA-256", m.sha256);
      if (m.zip?.url) add("Zip download", new URL(m.zip.url, location.href).pathname);
      facts.hidden = false;
    })
    .catch(() => {});
</script>
