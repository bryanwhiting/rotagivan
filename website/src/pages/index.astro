---
import Layout from "../layouts/Layout.astro";
import Demo from "../components/Demo.astro";
import DownloadButton from "../components/DownloadButton.astro";

const features = [
  {
    icon: "◎",
    title: "HUD on a tap",
    body: "Tap or swipe on your trackpad and a wheel of your apps, websites and actions appears under the pointer. Nest groups, pick a theme.",
  },
  {
    icon: "▥",
    title: "Window tiling",
    body: "Halves, thirds, quarters, fill the desktop or full screen, from a tile or a hotkey you assign.",
  },
  {
    icon: "⌘",
    title: "Macros and hotkeys",
    body: "Chain keystrokes and app launches into a named macro. One organizer shows every key, gesture and conflict.",
  },
  {
    icon: "◈",
    title: "Chrome tabs and bookmarks",
    body: "A HUD of your open Chrome tabs, most recent first, with favicons and profile names. Bookmarks too.",
  },
  {
    icon: "#",
    title: "Slack channels",
    body: "Jump to a Slack channel or conversation from the wheel without leaving what you are doing.",
  },
  {
    icon: "≋",
    title: "Voice mode",
    body: "Say “open Slack”. Rotagivan matches it against your own actions and shows the best three. Nothing runs until you confirm.",
    paid: true,
  },
];
---

<Layout
  title="Rotagivan — a radial HUD for your Mac"
  description="Tap your trackpad and a wheel of your apps, windows, Chrome tabs and macros appears under your fingers. Free for macOS."
>
  <section class="hero wrap">
    <h1>Your Mac, one tap away.</h1>
    <p class="lede">
      Tap the trackpad and a wheel of your apps, windows, tabs and macros
      appears under your fingers. Free for Mac, Voice mode optional.
    </p>
    <div class="button-row">
      <DownloadButton />
    </div>
    <div id="playground">
      <Demo />
    </div>
  </section>

  <section class="section wrap" id="features">
    <div class="section-heading">
      <h2>What it does</h2>
      <p>A native menu bar app. Everything here is in the download.</p>
    </div>
    <div class="feature-grid">
      {
        features.map((f) => (
          <article class="card">
            <span class="feature-icon" aria-hidden="true">
              {f.icon}
            </span>
            <h3>
              {f.title}
              {f.paid && <span class="tag">PAID</span>}
            </h3>
            <p>{f.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <div class="wrap">
    <p class="works-with">
      Works with
      <span>Apple trackpad</span>
      <span>ZSA Navigator</span>
      <span>Google Chrome</span>
      <span>Slack</span>
    </p>
  </div>

  <section class="section wrap" id="download">
    <div class="card download-panel">
      <h2>Download Rotagivan</h2>
      <DownloadButton withVersion variant="large" label="Download Rotagivan" />
      <p class="fineprint">
        Free. Takes a minute to install. <a href="/download/">Install steps and checksum</a>
      </p>
    </div>
  </section>
</Layout>
