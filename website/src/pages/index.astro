---
import Layout from "../layouts/Layout.astro";
import Demo from "../components/Demo.astro";
import DownloadButton from "../components/DownloadButton.astro";

const features = [
  {
    icon: "◎",
    title: "HUD on a tap",
    body: "Tap or swipe on your trackpad and a wheel of your apps, websites and actions appears under the pointer. Nest groups, pick a theme.",
  },
  {
    icon: "▥",
    title: "Window tiling",
    body: "Halves, thirds, quarters, fill the desktop or full screen, from a tile or a hotkey you assign.",
  },
  {
    icon: "⌘",
    title: "Macros and hotkeys",
    body: "Chain keystrokes and app launches into a named macro. One organizer shows every key, gesture and conflict.",
  },
  {
    icon: "◈",
    title: "Chrome tabs and bookmarks",
    body: "A HUD of your open Chrome tabs, most recent first, with favicons and profile names. Bookmarks too.",
  },
  {
    icon: "#",
    title: "Slack channels",
    body: "Jump to a Slack channel or conversation from the wheel without leaving what you are doing.",
  },
  {
    icon: "≋",
    title: "Voice mode",
    body: "Say “open Slack”. Rota matches it against your own actions and shows the best three. Nothing runs until you confirm.",
    paid: true,
  },
];
---

<Layout
  title="Rota — a radial HUD for your Mac"
  description="Tap your trackpad and a wheel of your apps, windows, Chrome tabs and macros appears under your fingers. Free for macOS."
>
  <section class="hero wrap">
    <h1>Your Mac, one tap away.</h1>
    <p class="lede">
      Tap the trackpad and a wheel of your apps, windows, tabs and macros
      appears under your fingers. Free for Mac, Voice mode optional.
    </p>
    <div class="button-row">
      <DownloadButton />
    </div>
    <div class="button-row tour-row">
      <button
        class="button secondary"
        type="button"
        data-tour-toggle
        aria-expanded="false"
        aria-controls="tour"
      >
        Watch the 60-second tour <span aria-hidden="true">▷</span>
      </button>
    </div>
    <div class="tour" id="tour" hidden>
      <video
        controls
        playsinline
        preload="none"
        poster="/rota-tour-poster.jpg"
        width="1280"
        height="800"
        data-tour-video
      >
        <source src="/rota-tour.mp4" type="video/mp4" />
        Your browser cannot play this video.
        <a href="/rota-tour.mp4">Download the tour (MP4)</a>.
      </video>
      <p class="fineprint">
        Recorded from the interactive demo below. Captions, no sound.
      </p>
    </div>
    <div id="playground">
      <Demo />
    </div>
  </section>

  <section class="section wrap" id="features">
    <div class="section-heading">
      <h2>What it does</h2>
      <p>A native menu bar app. Everything here is in the download.</p>
    </div>
    <div class="feature-grid">
      {
        features.map((f) => (
          <article class="card">
            <span class="feature-icon" aria-hidden="true">
              {f.icon}
            </span>
            <h3>
              {f.title}
              {f.paid && <span class="tag">PAID</span>}
            </h3>
            <p>{f.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <div class="wrap">
    <p class="works-with">
      Works with
      <span>Apple trackpad</span>
      <span>ZSA Navigator</span>
      <span>Google Chrome</span>
      <span>Slack</span>
    </p>
  </div>

  <section class="section wrap" id="download">
    <div class="card download-panel">
      <h2>Download Rota</h2>
      <DownloadButton withVersion variant="large" label="Download Rota" />
      <p class="fineprint">
        Free. Takes a minute to install. <a href="/download/">Install steps and checksum</a>
      </p>
    </div>
  </section>
</Layout>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-tour-toggle]");
  const tour = document.getElementById("tour");
  const video = document.querySelector<HTMLVideoElement>("[data-tour-video]");
  if (toggle && tour && video) {
    toggle.addEventListener("click", () => {
      const open = tour.hidden;
      tour.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.firstChild!.textContent = open ? "Hide the tour " : "Watch the 60-second tour ";
      if (open) {
        tour.scrollIntoView({ block: "nearest", behavior: "smooth" });
        video.play().catch(() => {});
      } else {
        video.pause();
      }
    });
  }
</script>
