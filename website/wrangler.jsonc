{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rotagivan-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "routes": [{ "pattern": "rota.silvermine.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only these paths run the Worker; everything else is served as static assets.
    "run_worker_first": [
      "/api/*",
      "/latest.json",
      "/download/latest",
      "/download/latest.zip",
      "/releases/*",
    ],
  },
  // Private bucket: files are served only through the Worker routes above.
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "rotagivan-releases" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rotagivan-licenses",
      "database_id": "5c0b41dd-8670-4b7d-a1f1-ce7d148dfaef",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "SITE_URL": "https://rota.silvermine.dev",
    // Set to your Stripe Price id (price_...) for Voice mode. Empty = checkout disabled.
    "STRIPE_PRICE_ID_VOICE": "",
    // "subscription" for a recurring price, "payment" for a one-time price.
    "STRIPE_CHECKOUT_MODE": "subscription",
    "LICENSE_MAX_DEVICES": "3",
    "ENTITLEMENT_TTL_DAYS": "7",
  },
  // Secrets (wrangler secret put): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, LICENSE_SIGNING_KEY
  "observability": { "enabled": true },
}
