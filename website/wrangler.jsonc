{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rotagivan-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  // rotahud.com is the site. www and the former hostname redirect pages to it
  // (REDIRECT_HOSTS below) while still serving releases and the API for apps
  // and Stripe that call them by absolute URL.
  "routes": [
    { "pattern": "rotahud.com", "custom_domain": true },
    { "pattern": "www.rotahud.com", "custom_domain": true },
    { "pattern": "rota.silvermine.dev", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Every request runs the Worker (host redirects); unhandled paths fall through to the static build.
    "run_worker_first": true,
  },
  // Private bucket: files are served only through the Worker routes above.
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "rotagivan-releases" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rotagivan-licenses",
      "database_id": "5c0b41dd-8670-4b7d-a1f1-ce7d148dfaef",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "SITE_URL": "https://rotahud.com",
    "REDIRECT_HOSTS": "www.rotahud.com,rota.silvermine.dev",
    // Set to your Stripe Price id (price_...) for Voice mode. Empty = checkout disabled.
    "STRIPE_PRICE_ID_VOICE": "",
    // "subscription" for a recurring price, "payment" for a one-time price.
    "STRIPE_CHECKOUT_MODE": "subscription",
    "LICENSE_MAX_DEVICES": "3",
    "ENTITLEMENT_TTL_DAYS": "7",
  },
  // Secrets (wrangler secret put): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, LICENSE_SIGNING_KEY
  "observability": { "enabled": true },
}
